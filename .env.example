# Copy to .env and change the passwords.
POSTGRES_PASSWORD=change-me
FILMBOX_WEB_PASSWORD=change-me-too

# With Docker (port 5433). The password here must be FILMBOX_WEB_PASSWORD.
DATABASE_URL=postgres://filmbox_web:change-me-too@localhost:5433/filmbox

# Without Docker (Postgres.app, port 5431): use your Mac user, or filmbox_web as in GUIDE.md step 4B.
# DATABASE_URL=postgres://YOUR_MAC_USER@localhost:5431/filmbox
